<Window x:Class="Anteroom.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Anteroom — Advanced settings"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="#F4F5F7">

    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#1B1D21" />
        <SolidColorBrush x:Key="TextMuted" Color="#5D646E" />
        <SolidColorBrush x:Key="Hairline" Color="#DCDFE4" />
        <SolidColorBrush x:Key="Accent" Color="#C97A22" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,12,14,12">

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="SESSION TABS" />

                    <CheckBox x:Name="DisplayTabsBox" Content="Display tabs"
                              ToolTip="Shows one tab per running Claude Code session. A tab appears automatically as soon as a session starts."
                              Checked="OnDisplayTabsToggled" Unchecked="OnDisplayTabsToggled" />
                    <CheckBox x:Name="AlwaysOnTopBox" Content="Always on top" Margin="22,0,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Position" VerticalAlignment="Center" />
                        <ComboBox x:Name="PositionBox" Grid.Row="0" Grid.Column="1" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Display screen"
                                   VerticalAlignment="Center" Margin="0,6,0,0" />
                        <ComboBox x:Name="ScreenBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" />

                        <TextBlock x:Name="ScreenHint" Grid.Row="2" Grid.Column="1"
                                   Style="{StaticResource Hint}" Text="Only one screen detected." />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="NOTIFICATION SOUND" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="SoundBox" Grid.Column="0" Content="Play a sound when a session needs you"
                                  VerticalAlignment="Center" Margin="0"
                                  Checked="OnSoundToggled" Unchecked="OnSoundToggled" />
                        <ComboBox x:Name="SoundSelect" Grid.Column="1" />
                        <Button x:Name="PreviewButton" Grid.Column="2" Content="Preview" Margin="6,0,0,0"
                                Padding="10,2" Click="OnPreviewSound" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="CLAUDE HOOKS" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                               Text="Events Anteroom listens to — hover for what each one does. Turn off Stop if a ping every time Claude finishes talking is too much." />
                    <ItemsControl x:Name="HookList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <primitives:UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="PERMISSION PROMPTS" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="GatingBox" Grid.Column="0" VerticalAlignment="Center" Margin="0"
                                  Content="Answer permission prompts from the tabs"
                                  ToolTip="Anteroom decides the tools you tick below, instead of Claude prompting in the terminal."
                                  Checked="OnGatingToggled" Unchecked="OnGatingToggled" />
                        <TextBlock Grid.Column="1" Text="Wait up to" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="HoldBox" Grid.Column="2" />
                    </Grid>

                    <StackPanel x:Name="GatingDetail" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                   Text="Only the ticked tools are held. Anteroom cannot tell whether your own rules would have auto-approved a call, so tick only tools that actually prompt you. Unanswered calls fall back to Claude's prompt." />
                        <ItemsControl x:Name="GatedToolList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <primitives:UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AlwaysAllowText" Grid.Column="0" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" Text="No remembered allow rules." />
                            <Button x:Name="ClearRulesButton" Grid.Column="1" Content="Forget rules" Padding="10,2"
                                    Click="OnClearRules" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="CONNECTION TO CLAUDE CODE" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="SetupStatusText" TextWrapping="Wrap" />
                            <TextBlock x:Name="SetupDetailText" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect" Padding="14,4"
                                VerticalAlignment="Center" Click="OnConnect" />
                        <Button x:Name="DisconnectButton" Grid.Column="2" Content="Remove hooks" Padding="12,4"
                                Margin="6,0,0,0" VerticalAlignment="Center" Click="OnDisconnect" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Merges Anteroom's hooks into ~/.claude/settings.json. Existing settings are kept and backed up first." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="GENERAL" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="StartupBox" Grid.Column="0" Content="Start Anteroom when I sign in"
                                  VerticalAlignment="Center" Margin="0" />
                        <TextBlock Grid.Column="1" Text="Forget a session after" VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox x:Name="StaleBox" Grid.Column="2" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="16,4" Click="OnCancel" />
                <Button Content="Save" Padding="20,4" Margin="8,0,0,0" Click="OnSave" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
