<Window x:Class="Anteroom.App.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anteroom — Update"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Background="#F4F5F7">

    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#1B1D21" />
        <SolidColorBrush x:Key="TextMuted" Color="#5D646E" />
        <SolidColorBrush x:Key="Hairline" Color="#DCDFE4" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold" Text="An update is available" />
        <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,4,0,0" />

        <Border Background="#FFFFFF" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="RELEASE NOTES" Foreground="{StaticResource TextMuted}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <TextBlock x:Name="InstallNote" Style="{StaticResource Hint}" Margin="0,10,0,0"
                   Text="The update replaces this installation in place, so your Claude hook registration and settings are kept. Anteroom restarts itself when it is done." />

        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" Text="Downloading…" />
            <ProgressBar x:Name="ProgressBar" Height="6" Minimum="0" Maximum="100" Margin="0,4,0,0" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Style="{StaticResource Hint}" Foreground="#B3261E"
                   Visibility="Collapsed" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ReleasePageButton" Content="Release page" Padding="12,4" Click="OnOpenReleasePage" />
            <Button x:Name="SkipButton" Content="Skip this version" Padding="12,4" Margin="8,0,0,0" Click="OnSkip" />
            <Button x:Name="LaterButton" Content="Later" Padding="14,4" Margin="8,0,0,0" Click="OnLater" />
            <Button x:Name="InstallButton" Content="Download and install" Padding="16,4" Margin="8,0,0,0"
                    Click="OnInstall" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
